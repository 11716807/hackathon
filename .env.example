# Required for Live Gemini (phone reads the real label / guard).
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash. For the Cup you can set gemini-3.8-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional. "live" or "practice". Practice works with no key (demo / tests).
NEXT_PUBLIC_DEFAULT_ENGINE=practice
