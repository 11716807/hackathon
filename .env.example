# Required for Live Gemini (phone reads the real label / guard).
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.8-flash (2.5-flash is unavailable for new keys).
GEMINI_MODEL=gemini-3.8-flash

# Optional. "live" or "practice". Use "live" for Cloud Run demos.
NEXT_PUBLIC_DEFAULT_ENGINE=live

# --- Google Cloud (add as we wire each service) ---
# GCP project id (same as `gcloud config get-value project`)
GCP_PROJECT_ID=

# Cloud Run region
GCP_REGION=asia-south1

# Cloud Run service name
CLOUD_RUN_SERVICE=golden-frame

# Firestore (step 2) — set GCP_PROJECT_ID above; uses database (default)
# FIRESTORE_DATABASE=(default)

# Cloud Storage bucket for goldens + captures (step 3)
GCS_BUCKET=

# Document AI processor for label SKU OCR (step 4)
# Processor id only (e.g. 40acb2a3d0b0b753) or full resource name
DOCUMENT_AI_PROCESSOR=
DOCUMENT_AI_LOCATION=us
